{
    "name": "e09bbebd-291d-404a-b9fc-76fe2cfb7fe4",
    "id": "/providers/Microsoft.Flow/flows/e09bbebd-291d-404a-b9fc-76fe2cfb7fe4",
    "type": "Microsoft.Flow/flows",
    "properties": {
        "apiId": "/providers/Microsoft.PowerApps/apis/shared_logicflows",
        "displayName": "Clear Message History (Keyword /clear)",
        "definition": {
            "metadata": {
                "creationSource": "Portal",
                "modifiedSources": "Portal"
            },
            "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
            "contentVersion": "1.0.0.0",
            "parameters": {
                "$authentication": {
                    "defaultValue": {},
                    "type": "SecureObject"
                },
                "$connections": {
                    "defaultValue": {},
                    "type": "Object"
                }
            },
            "triggers": {
                "When_keywords_are_mentioned": {
                    "type": "OpenApiConnectionWebhook",
                    "inputs": {
                        "parameters": {
                            "$search": "\"/clear\"",
                            "threadType": "groupchat",
                            "requestBody/chats": [
                                "48:notes"
                            ]
                        },
                        "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                            "connectionName": "shared_teams",
                            "operationId": "WebhookKeywordTrigger"
                        },
                        "authentication": "@parameters('$authentication')"
                    }
                }
            },
            "actions": {
                "Get_My_User_Id": {
                    "runAfter": {},
                    "type": "OpenApiConnection",
                    "inputs": {
                        "parameters": {
                            "Uri": "https://graph.microsoft.com/v1.0/me?$select=id",
                            "Method": "GET"
                        },
                        "host": {
                            "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                            "connectionName": "shared_teams",
                            "operationId": "HttpRequest"
                        },
                        "authentication": "@parameters('$authentication')"
                    }
                },
                "Initialize_chatId": {
                    "runAfter": {
                        "Get_My_User_Id": [
                            "Succeeded"
                        ]
                    },
                    "type": "InitializeVariable",
                    "inputs": {
                        "variables": [
                            {
                                "name": "chatId",
                                "type": "string",
                                "value": "@concat('19:', body('Get_My_User_Id')?['id'], '_', body('Get_My_User_Id')?['id'], '@unq.gbl.spaces')"
                            }
                        ]
                    }
                },
                "Initialize_nextLink": {
                    "runAfter": {
                        "Initialize_chatId": [
                            "Succeeded"
                        ]
                    },
                    "type": "InitializeVariable",
                    "inputs": {
                        "variables": [
                            {
                                "name": "nextLink",
                                "type": "string",
                                "value": "@concat('https://graph.microsoft.com/v1.0/me/chats/', variables('chatId'), '/messages?$top=50')"
                            }
                        ]
                    }
                },
                "Initialize_messageIds": {
                    "runAfter": {
                        "Initialize_nextLink": [
                            "Succeeded"
                        ]
                    },
                    "type": "InitializeVariable",
                    "inputs": {
                        "variables": [
                            {
                                "name": "messageIds",
                                "type": "array",
                                "value": []
                            }
                        ]
                    }
                },
                "Collect_All_Message_Ids": {
                    "runAfter": {
                        "Initialize_messageIds": [
                            "Succeeded"
                        ]
                    },
                    "type": "Until",
                    "expression": "@empty(variables('nextLink'))",
                    "limit": {
                        "count": 5000,
                        "timeout": "PT1H"
                    },
                    "actions": {
                        "Get_Messages_Page": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                                "parameters": {
                                    "Uri": "@variables('nextLink')",
                                    "Method": "GET"
                                },
                                "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                                    "connectionName": "shared_teams",
                                    "operationId": "HttpRequest"
                                },
                                "authentication": "@parameters('$authentication')"
                            }
                        },
                        "Keep_Deletable_Messages": {
                            "runAfter": {
                                "Get_Messages_Page": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Query",
                            "inputs": {
                                "from": "@coalesce(body('Get_Messages_Page')?['value'], createArray())",
                                "where": "@and(equals(item()?['messageType'], 'message'), equals(coalesce(item()?['deletedDateTime'], ''), ''))"
                            }
                        },
                        "Collect_Page_Ids": {
                            "runAfter": {
                                "Keep_Deletable_Messages": [
                                    "Succeeded"
                                ]
                            },
                            "type": "Foreach",
                            "foreach": "@body('Keep_Deletable_Messages')",
                            "runtimeConfiguration": {
                                "concurrency": {
                                    "repetitions": 1
                                }
                            },
                            "actions": {
                                "Append_Message_Id": {
                                    "runAfter": {},
                                    "type": "AppendToArrayVariable",
                                    "inputs": {
                                        "name": "messageIds",
                                        "value": "@item()?['id']"
                                    }
                                }
                            }
                        },
                        "Set_Next_Link": {
                            "runAfter": {
                                "Collect_Page_Ids": [
                                    "Succeeded"
                                ]
                            },
                            "type": "SetVariable",
                            "inputs": {
                                "name": "nextLink",
                                "value": "@coalesce(body('Get_Messages_Page')?['@odata.nextLink'], '')"
                            }
                        }
                    }
                },
                "Delete_Each_Message": {
                    "runAfter": {
                        "Collect_All_Message_Ids": [
                            "Succeeded"
                        ]
                    },
                    "type": "Foreach",
                    "foreach": "@variables('messageIds')",
                    "runtimeConfiguration": {
                        "concurrency": {
                            "repetitions": 1
                        }
                    },
                    "actions": {
                        "Soft_Delete_Message": {
                            "runAfter": {},
                            "type": "OpenApiConnection",
                            "inputs": {
                                "parameters": {
                                    "Uri": "@concat('https://graph.microsoft.com/v1.0/me/chats/', variables('chatId'), '/messages/', item(), '/softDelete')",
                                    "Method": "POST"
                                },
                                "host": {
                                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_teams",
                                    "connectionName": "shared_teams",
                                    "operationId": "HttpRequest"
                                },
                                "authentication": "@parameters('$authentication')"
                            }
                        }
                    }
                }
            },
            "outputs": {}
        },
        "connectionReferences": {
            "shared_teams": {
                "connectionName": "shared_teams",
                "source": "Embedded",
                "id": "/providers/Microsoft.PowerApps/apis/shared_teams",
                "tier": "NotSpecified",
                "apiName": "teams",
                "isProcessSimpleApiReferenceConversionAlreadyDone": false
            }
        },
        "flowFailureAlertSubscribed": false,
        "isManaged": false
    }
}
